<Project Sdk="Microsoft.NET.Sdk">

  <!-- 実物のモーダル表示を出す検査。表示はプロセスの中のウィンドウを数えて答えるので、ほかの検査と
       同じプロセスでは並べて走らせられない。別のプロセスに分けて、ほかの検査と並べて走らせる。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PmxEditorMcp.HostPlugin.ModalTests</AssemblyName>
    <RootNamespace>PmxEditorMcp.Tests</RootNamespace>
    <RequiresPmxEditorDir>true</RequiresPmxEditorDir>
    <PmxEditorSdkCopied>true</PmxEditorSdkCopied>
  </PropertyGroup>

  <Import Project="..\..\PmxEditorSdk.props" />

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HostPlugin\PmxEditorMcp.HostPlugin.csproj" />
  </ItemGroup>

  <Import Project="..\HostPlugin.SharedFixtures.props" />

</Project>
