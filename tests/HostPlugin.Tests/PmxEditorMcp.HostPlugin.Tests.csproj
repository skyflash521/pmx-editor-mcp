<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>PmxEditorMcp.HostPlugin.Tests</AssemblyName>
    <RootNamespace>PmxEditorMcp.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 応答の照合で、ホストと同じシリアライザを使ってJSONを読み解くため。 -->
    <Reference Include="System.Web.Extensions" />
    <!-- 接続初期化の題材がSDKのインターフェースを実装するため。参照は推移しないのでここでも指す。
         テストは配布物と別のプロセスで動くので、読み込めるよう出力へ複製する(出力は配布しない)。 -->
    <Reference Include="PEPlugin">
      <HintPath>$(PmxEditorDir)\Lib\PEPlugin\PEPlugin.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HostPlugin\PmxEditorMcp.HostPlugin.csproj" />
  </ItemGroup>

</Project>
