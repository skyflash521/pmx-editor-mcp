                "equals": 0
              }
            ]
          }
        },
        {
          "kind": "file",
          "action": "ensureDirectory",
          "path": "%TEMP%\\pmx-editor-mcp-acceptance"
        },
        {
          "kind": "file",
          "action": "ensureMissing",
          "path": "%TEMP%\\pmx-editor-mcp-acceptance\\test.pmx"
        },
        {
          "kind": "tool",
          "tool": "session_save_pmx_file",
          "arguments": {
            "path": "%TEMP%\\pmx-editor-mcp-acceptance\\test.pmx",
            "confirm": false
          },
          "expect": {
            "ok": false,
            "code": "TOOL_CONFIRM_REQUIRED"
          }
        },
        {
          "kind": "file",
          "action": "expectMissing",
          "path": "%TEMP%\\pmx-editor-mcp-acceptance\\test.pmx"
        },
        {
          "kind": "tool",
          "tool": "session_save_pmx_file",
          "arguments": {
