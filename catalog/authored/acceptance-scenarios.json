            "confirm": true
          },
          "expect": {
            "ok": true
          }
        },
        {
          "kind": "file",
          "action": "expectPresent",
          "path": "%TEMP%\\pmx-editor-mcp-acceptance\\test.pmx"
        },
        {
          "kind": "file",
          "action": "removeTree",
          "path": "%TEMP%\\pmx-editor-mcp-acceptance"
        }
      ]
