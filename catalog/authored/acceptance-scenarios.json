{
  "scenarios": [
    {
      "id": 1,
      "title": "疎通と初期化",
      "requirements": [
        "標準のMCPで動く製品にし、特定のクライアントに縛られない"
      ],
      "steps": [
        {
          "kind": "control",
          "action": "closeAll"
        },
        {
          "kind": "control",
          "action": "launch",
          "record": {
            "name": "editorA",
            "shape": "number"
          }
        },
        {
          "kind": "tool",
          "tool": "ping",
          "arguments": {},
          "expect": {
            "ok": true,
            "notice": {
              "editor": {
                "$from": "editorA"
              }
            },
            "body": {
              "equals": "pong"
            }
          }
        },
        {
          "kind": "tool",
          "tool": "session_initialize_pmx",
          "arguments": {
            "confirm": true
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "読み取り",
      "requirements": [
        "モデルの構造の把握"
      ],
      "steps": [
        {
          "kind": "tool",
          "tool": "model_list_model_infos",
          "arguments": {
            "fields": [
              "modelName"
            ]
          },
          "expect": {
            "ok": true,
            "values": [
              {
                "path": "total",
                "equals": 1
              }
            ]
          }
        },
        {
          "kind": "tool",
          "tool": "model_list_vertices",
          "arguments": {
            "all": true
          },
          "expect": {
            "ok": true,
            "values": [
              {
                "path": "total",
                "equals": 0
              }
            ]
          }
        }
      ]
    },
