<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- 実行対象は x64 版エディタ(PmxEditor_x64.exe)のプロセスだが、
         ホストは呼び出し側のビット数に依存しないため AnyCPU でビルドする。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>PmxEditorMcp</AssemblyName>
    <RootNamespace>PmxEditorMcp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- SDKを読むので、導入ディレクトリの指定が要る。 -->
    <RequiresPmxEditorDir>true</RequiresPmxEditorDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PmxEditorMcp.HostPlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配布物のDLLは再配布できないため、各自の導入物を参照するだけで出力へコピーしない。 -->
    <Reference Include="PEPlugin">
      <HintPath>$(PmxEditorDir)\Lib\PEPlugin\PEPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 成分を並べる型の一部はこのライブラリが持つ。名前で引かずに読み書きするため、綴りではなく
         型そのものを指す。実体はエディタのプロセスに読み込まれているので出力へコピーしない。 -->
    <Reference Include="SlimDX">
      <HintPath>$(PmxEditorDir)\Lib\SlimDX\x64\SlimDX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- 同梱依存ゼロでJSONを扱うため、.NET Framework 付属の JavaScriptSerializer を使う。 -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- 行キーからSDKへの中継は、ビルドのたびに作り直して組み込む。配布物へ入るのは出来た本文
       だけで、呼び出し先を名前で引く経路は持たない。 -->
  <PropertyGroup>
    <!-- 中間の置き場は本文の評価の時点では決まっていないので、その元から組み立てる。 -->
    <RelaySourcePath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedSdkRelay.g.cs</RelaySourcePath>
    <ToolBindingSourcePath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedTools.g.cs</ToolBindingSourcePath>
    <RelayGeneratorPath>$(MSBuildThisFileDirectory)..\SignatureDump\bin\$(Configuration)\net48\PmxEditorMcp.SignatureDump.exe</RelayGeneratorPath>
    <ToolMapPath>$(MSBuildThisFileDirectory)..\..\data\authored\tool-map.json</ToolMapPath>
    <LedgerPath>$(MSBuildThisFileDirectory)..\..\data\observed\capability-ledger.json</LedgerPath>
    <TypeRolesPath>$(MSBuildThisFileDirectory)..\..\data\authored\type-roles.json</TypeRolesPath>
    <CommonAssignmentsPath>$(MSBuildThisFileDirectory)..\..\data\authored\common-assignments.json</CommonAssignmentsPath>
    <ToolSchemasPath>$(MSBuildThisFileDirectory)..\..\data\authored\tool-schemas.json</ToolSchemasPath>
  </PropertyGroup>

  <Target Name="BuildRelayGenerator">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SignatureDump\PmxEditorMcp.SignatureDump.csproj"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- 作り直しの要否は生成器の側が中身で判じるので、ここでは入力と出力の比べをしない。 -->
  <Target Name="GenerateRelaySource"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="EnsurePmxEditorDir;BuildRelayGenerator">
    <Exec Command="&quot;$(RelayGeneratorPath)&quot; relay-source &quot;$(PmxEditorDir)&quot; &quot;$(ToolMapPath)&quot; &quot;$(LedgerPath)&quot; &quot;$(RelaySourcePath)&quot;" />
    <ItemGroup>
      <Compile Include="$(RelaySourcePath)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- ツールの名前から呼ぶ行への結び付きも、同じ正本からビルドのたびに作り直して組み込む。 -->
  <Target Name="GenerateToolBindingSource"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="EnsurePmxEditorDir;BuildRelayGenerator">
    <Exec Command="&quot;$(RelayGeneratorPath)&quot; tool-bindings &quot;$(PmxEditorDir)&quot; &quot;$(LedgerPath)&quot; &quot;$(TypeRolesPath)&quot; &quot;$(CommonAssignmentsPath)&quot; &quot;$(ToolMapPath)&quot; &quot;$(ToolSchemasPath)&quot; &quot;$(ToolBindingSourcePath)&quot;" />
    <ItemGroup>
      <Compile Include="$(ToolBindingSourcePath)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <Target Name="Deploy" DependsOnTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PmxEditorDir)\_plugin\User\" SkipUnchangedFiles="true" />
  </Target>

</Project>
