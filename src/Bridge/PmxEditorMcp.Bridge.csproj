<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PmxEditorMcp.Bridge</AssemblyName>
    <RootNamespace>PmxEditorMcp.Bridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- ホスト側と記述の様式を揃えるため、暗黙のusingとnull許容注釈は使わない。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- ModelContextProtocol が推移的に持つのは Hosting.Abstractions だけで、
         Generic Host の実装は含まれないため直接参照する。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
