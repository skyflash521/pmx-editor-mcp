<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- SlimDX の x64 混在モードアセンブリを解決するため、64ビットで実行する。 -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PmxEditorMcp.SignatureDump</AssemblyName>
    <RootNamespace>PmxEditorMcp.SignatureDump</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 入力の形の照合は、汎用のJSON Schemaの実装に任せる。自前で書くと、綴った規則のうち
         実装した範囲だけが効く検査になる。 -->
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\HostPlugin\ToolEnvelopeCodes.cs" Link="ToolEnvelopeCodes.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 受入シナリオの定義の形は、この宣言1つから照合する。 -->
    <EmbeddedResource Include="AcceptanceScenarioSchema.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
