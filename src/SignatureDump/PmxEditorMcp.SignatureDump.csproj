<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- SlimDX の x64 混在モードアセンブリを解決するため、64ビットで実行する。 -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PmxEditorMcp.SignatureDump</AssemblyName>
    <RootNamespace>PmxEditorMcp.SignatureDump</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- 入力の形の照合は、汎用のJSON Schemaの実装に任せる。自前で書くと、綴った規則のうち
         実装した範囲だけが効く検査になる。 -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 受入シナリオの定義の形は、この宣言1つから照合する。 -->
    <EmbeddedResource Include="AcceptanceScenarioSchema.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
