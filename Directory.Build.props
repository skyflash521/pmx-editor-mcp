<Project>

  <!-- 配布のバージョン。ホストとブリッジのアセンブリも、配布するパッケージの名前もこの値を共有する。 -->
  <PropertyGroup>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <!-- PMXエディタ導入ディレクトリ(PmxEditorDir)は各自の環境ごとに異なるため、
       Git管理外の local.props で定義する。存在しない環境でも読み込み自体は成立させ、
       未定義のままホストをビルドしたときに明示エラーで失敗させる。 -->
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />

  <!-- 未定義のまま進むことを、SDKを要るプロジェクトのビルドとデプロイの前で止める。要るかどうかは
       各プロジェクトが RequiresPmxEditorDir で名乗る——SDKを読まないプロジェクトまで導入を必須に
       しない。 -->
  <Target Name="EnsurePmxEditorDir" BeforeTargets="BeforeBuild;Deploy"
          Condition="'$(RequiresPmxEditorDir)' == 'true'">
    <Error Condition="'$(PmxEditorDir)' == ''"
           Text="local.props に PmxEditorDir を定義せよ(PMXエディタ導入ディレクトリのパス)。" />
  </Target>

</Project>
